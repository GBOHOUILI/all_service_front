# Umami Cloud (https://cloud.umami.is) : identifiant du site. Vide = pas d'analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Compte admin unique. Les trois variables sont requises, sinon /admin renvoie une 404.
# Secret de session : longue chaîne aléatoire, par exemple `openssl rand -base64 32`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 1 = réactive les pages maquettes du compte client pour une démo.
NEXT_PUBLIC_DEMO_PAGES=
